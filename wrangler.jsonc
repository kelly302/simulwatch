// Cloudflare Workers の静的アセット（docs/deploy.md の 3・6-1。2026-10-26 決定 D-02）。Worker のコードは無く、dist/ をそのまま出す。
// アップロードは日次・手動のワークフローの cloudflare/wrangler-action（本番は deploy、プレビューは versions upload --preview-alias preview）
{
  // Worker 名。公開の URL は https://<name>.<アカウントのサブドメイン>.workers.dev になる（docs/deploy.md 1-B-5。最初の公開の前に決める。仮）
  "name": "simulwatch",
  // 使う wrangler（4.155.0）より前の日付にする
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  // プレビュー（版の URL・preview-<name>.<サブドメイン>.workers.dev）を出す。URL を知っていれば誰でも見られる（docs/deploy.md 4）
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // いちばん近い 404.html を 404 で返す（ビルドが dist/404.html を作る）
    "not_found_handling": "404-page",
    // 既定と同じ。ファイルがある所だけ末尾スラッシュを付け直す（/works/x → 307 → /works/x/）。無いページは _redirects（両方の形を書いている）か 404
    "html_handling": "auto-trailing-slash"
  }
}
