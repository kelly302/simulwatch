# このファイルを .env にコピーして値を入れる。.env はコミットしない（.gitignore 済み）
# GitHub Actions では同じ名前で Secrets に登録する

# YouTube Data API v3 のキー（Google Cloud Console で「YouTube Data API v3」を有効にして発行）
YOUTUBE_API_KEY=

# Annict の個人用アクセストークン（annict.com → 設定 → アプリ → 個人用アクセストークン。読み込み専用で十分）
ANNICT_TOKEN=

# R2（AI の判定の ai:pull・ai:push。docs/ai-ops.md 2-1）。Actions とは別の、ローカル用の R2 の API トークン（Object Read & Write・このバケットだけ）。
# 中から AWS CLI（aws）を呼ぶ。漏れたらこのトークンだけを取り消す。R2 を設定する前は --remote にローカルのフォルダを渡す
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
