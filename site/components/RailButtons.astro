---
// 棚（.rail）を左右に送る矢印。マウスの端末だけに出す（global.css の .rail-btns）。動きは site/scripts/rail.ts。
// 同じ section の中の、見えている棚を送る
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="rail-btns" role="group" aria-label={`${label}を送る`}>
  <button type="button" data-rail-dir="-1" aria-label="前へ" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
  <button type="button" data-rail-dir="1" aria-label="次へ"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
</div>
