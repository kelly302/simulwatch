---
// ページの共通の枠（head・ヘッダー・フッター）。canonical は自分自身（末尾スラッシュ）
import "../styles/global.css";
import { cfg, viewsUpdated } from "../lib/data.ts";
import { formatDate } from "../../src/shared/site.ts";

interface Props {
  title: string;
  description: string;
  /** サイトの中のパス（/works/annict-1234/） */
  path: string;
  nav?: "top" | "works" | "streamers" | null;
  jsonLd?: unknown[];
  /** og:image のパス（無ければサイト共通の画像） */
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, path, nav = null, jsonLd = [], ogImage = "/og/default.png", ogType = "website", noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#221A29" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:site_name" content={cfg.site_name}>
<meta property="og:locale" content="ja_JP">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://i.ytimg.com" crossorigin>
{jsonLd.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
</head>
<body>
<header class="site">
  <div class="wrap">
    <a class="logo" href="/">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="3" width="15" height="12" rx="3" fill="var(--uv)"></rect><rect x="8" y="9" width="15" height="12" rx="3" fill="var(--mint)" stroke="var(--ink)" stroke-width="2"></rect></svg>
      {cfg.site_name}
    </a>
    {/* スマホでは画面の下に固定するタブ、幅が広ければヘッダーの右（global.css の .nav） */}
    <nav class="nav" aria-label="メイン">
      <a href="/" aria-current={nav === "top" ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"></path></svg>トップ</a>
      <a href="/works/" aria-current={nav === "works" ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="10"></rect><rect x="13.5" y="3.5" width="7" height="10"></rect><path d="M3.5 17.5h17M3.5 20.5h11"></path></svg>作品</a>
      <a href="/streamers/" aria-current={nav === "streamers" ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4-6 8-6s7 2 8 6"></path></svg>配信者</a>
    </nav>
  </div>
</header>
<slot />
<footer class="site-foot">
  <div class="wrap">
    <div class="name">{cfg.site_name}</div>
    <div>動画の情報は YouTube Data API を使って取得しています。サムネイルを押すと YouTube の動画ページを開きます。</div>
    <div>作品情報: Annict / AniList / Wikipedia・Wikidata</div>
    {viewsUpdated && <div>再生数は毎日更新しています（最終更新 {formatDate(viewsUpdated)}）</div>}
    <nav aria-label="サイトの情報">
      <a href="/about/">このサイトについて</a>
      <a href="/privacy/">プライバシーポリシー（広告・Cookie）</a>
      <a href="https://www.youtube.com/t/terms">YouTube 利用規約</a>
      <a href="https://policies.google.com/privacy">Google プライバシーポリシー</a>
    </nav>
  </div>
</footer>
</body>
</html>
