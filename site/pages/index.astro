---
// トップ。ランキング（3期間）・これから始まる枠・よく同時視聴される作品・同時視聴した枠（新しい順24枠）をビルド時の HTML に入れる。
// 上の3つは横に流す棚（2026-10-20）。「さらに表示」で新しい順300枠の JSON、絞り込み・並べ替え・300枠より先で全件の索引と辞書を読む（site/scripts/top.ts）
import Base from "../layouts/Base.astro";
import RailButtons from "../components/RailButtons.astro";
import { cfg, completed, ranking, site, sortWorks, streamerById, upcoming, workById, viewsUpdated, worksOfTab } from "../lib/data.ts";
import { dictFor, encodeRow } from "../lib/encode.ts";
import { cardHtml, workCardHtml } from "../lib/views.ts";
import { EMPTY, axisButtonsHtml } from "../lib/filters.ts";
import { AFFILIATION_LABEL, BRANCH_LABEL } from "../../src/shared/types.ts";
import type { Affiliation, Branch } from "../../src/shared/types.ts";
import { SEASONS, SEASON_LABEL, formatDate, metaLine } from "../../src/shared/site.ts";

// ランキング: 棚に設定の枠数（8枠）、「続きを見る」で RANKING_MORE 位まで（HTML に入れて隠しておく。2026-10-20）
const RANKING_MORE = 30;
const periods = cfg.top.ranking_periods.map((days) => {
  const all = ranking(days, RANKING_MORE);
  const evs = all.slice(0, cfg.top.ranking_size);
  const more = all.slice(cfg.top.ranking_size);
  return { days, label: days ? `${days}日` : "全期間", evs, more, dict: dictFor(all, streamerById, workById) };
});
// 最初に出す期間: 7日。7日に枠が無いときだけ30日、それも無ければ全期間（2026-10-20 ユーザー決定。巡回が止まったときに空の箱から始まらないように）
const firstPeriod = Math.max(0, periods.findIndex((p) => p.evs.length > 0));
const viewsAt = viewsUpdated ? formatDate(viewsUpdated).slice(5) : "";
const up = upcoming;
const upDict = dictFor(up, streamerById, workById);
const recent = completed.slice(0, cfg.top.recent_html);
const recentDict = dictFor(recent, streamerById, workById);
// よく同時視聴される作品（作品一覧の既定の並び＝観た配信者の多い順の先頭）
const WORKS_RAIL = 12;
const topWorks = sortWorks(worksOfTab("all"), "streamers", false).slice(0, WORKS_RAIL);

// 絞り込みの選択肢（データにある所属の区分・放送年だけ）
const BRANCH_ORDER: Branch[] = ["jp", "en", "kr", "id"];
const affs = (["nijisanji", "hololive", "vspo"] as Affiliation[]).map((aff) => {
  const ids = new Set(completed.map((e) => e.streamerId));
  const branches = BRANCH_ORDER.filter((b) => site.streamers.some((s) => s.affiliation === aff && s.branch === b && ids.has(s.id)));
  return { aff, label: AFFILIATION_LABEL[aff], branches };
}).filter((a) => a.branches.length > 0);
// 配信日の「年で選ぶ」の選択肢（枠のある年。日本時間）
const streamYears = [...new Set(completed.map((e) => Number(formatDate(e.startedAt).slice(0, 4))))].sort((a, b) => b - a);
const years = [...new Set(completed.flatMap((e) => e.works.map((w) => workById.get(w.id)?.year)).filter((y): y is number => !!y))].sort((a, b) => b - a);

// h1 と title（2026-10-20 ユーザー決定。「ミラー配信」は title と meta description に残す）
const H1_PREFIX = "にじさんじ・ホロライブ・ぶいすぽっ！";
const description = `にじさんじ・ホロライブ・ぶいすぽっ！の配信者が同時視聴（ミラー配信）した作品と枠をまとめています。${site.works.filter((w) => w.hasPage).length.toLocaleString()}作品・${completed.length.toLocaleString()}枠。作品から配信者を、配信者から観た作品をたどれます。`;
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: cfg.site_name,
  url: new URL("/", Astro.site).href,
  inLanguage: "ja",
  description,
}];
const lastShown = recent.at(-1);
const topConfig = { generatedAt: site.generatedAt, recentHtml: cfg.top.recent_html, recentJson: cfg.top.recent_json, total: completed.length };
---
<Base title={`${H1_PREFIX}の同時視聴（ミラー配信）まとめ | ${cfg.site_name}`} description={description} path="/" nav="top" jsonLd={jsonLd}>
<main class="wrap" id="top">
  {/* 事務所名の途中では折り返さない（「ぶいす／ぽっ！」にならないように） */}
  <h1 class="lead">{H1_PREFIX.split(/(?<=・)/).map((x) => <span class="nw">{x}</span>)}の同時視聴まとめ</h1>

  <section class="block" aria-labelledby="h-rank">
    <div class="block-head">
      <h2 id="h-rank">ランキング</h2>
      <div class="tools">
        <div class="utabs" role="group" aria-label="期間" id="rank-period">
          {periods.map((p, i) => <button type="button" data-period={String(p.days)} aria-pressed={i === firstPeriod ? "true" : "false"}>{p.label}</button>)}
        </div>
        <RailButtons label="ランキング" />
      </div>
    </div>
    {periods.map((p, i) => (
      <div class="rank-pane" data-period={String(p.days)} hidden={i !== firstPeriod}>
        <p class="note">{p.days ? `この${p.days}日に配信された` : "これまでに配信された"}公開枠を、再生数の多い順に。{viewsAt && `再生数は ${viewsAt} 時点。`}</p>
        {p.evs.length
          ? <div class="rail two" set:html={p.evs.map((e, j) => cardHtml(encodeRow(e), p.dict, { rank: j + 1, lazy: i !== firstPeriod || j >= 4 })).join("")} />
          : <p class="empty note">この期間に配信された公開枠はまだありません。ほかの期間を選んでください。</p>}
        {p.more.length > 0 && (
          <Fragment>
            <ol class="rank-list" id={`rank-more-${p.days}`} hidden set:html={p.more.map((e, j) => `<li>${cardHtml(encodeRow(e), p.dict, { rank: cfg.top.ranking_size + j + 1 })}</li>`).join("")} />
            <button type="button" class="btn rank-more" aria-expanded="false" aria-controls={`rank-more-${p.days}`} data-label={`続きを見る（${cfg.top.ranking_size + 1}〜${cfg.top.ranking_size + p.more.length}位）`}>続きを見る（{cfg.top.ranking_size + 1}〜{cfg.top.ranking_size + p.more.length}位）</button>
          </Fragment>
        )}
      </div>
    ))}
  </section>

  <aside class="ad" aria-label="広告"></aside>

  {up.length
    ? <section class="block band" aria-labelledby="h-up">
        <div class="block-head">
          <h2 id="h-up">これから始まる枠 <span class="count">{up.length}枠・配信中を先頭に</span></h2>
          <RailButtons label="これから始まる枠" />
        </div>
        <div class="rail" set:html={up.map((e, j) => cardHtml(encodeRow(e), upDict, { lazy: j >= 2 })).join("")} />
      </section>
    : <section class="block" aria-labelledby="h-up">
        <h2 id="h-up">これから始まる枠</h2>
        <p class="note">予定されている枠はありません。</p>
      </section>}

  {topWorks.length > 0 && (
    <section class="block" aria-labelledby="h-works">
      <div class="block-head">
        <h2 id="h-works">よく同時視聴される作品</h2>
        <div class="tools">
          <a class="see-all" href="/works/">作品をすべて見る</a>
          <RailButtons label="よく同時視聴される作品" />
        </div>
      </div>
      <div class="rail covers" set:html={topWorks.map((w) => workCardHtml({ key: w.key!, title: w.title, image: w.imageUrl, streamers: w.streamersCount, events: w.eventsCount, meta: metaLine(w) })).join("")} />
    </section>
  )}

  <section class="block" aria-labelledby="h-done" id="done">
    <h2 id="h-done">同時視聴した枠</h2>
    {/* 並び順の段と条件のボタン（2026-10-20。条件は軸のボタンを折り返して全部並べ、押すとその軸の選択肢がすぐ下に開く） */}
    <div class="ftool">
      <div class="sortbar">
        <div class="keys" role="group" aria-label="並び順">
          <button type="button" class="pill" data-sort="date" aria-pressed="true">配信日順</button>
          <button type="button" class="pill" data-sort="views" aria-pressed="false">再生数順</button>
        </div>
        <button type="button" class="pill rev" id="rev" aria-pressed="false" aria-label="逆順にする（今は新しい順）">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M4 17l3 3 3-3M17 20V4M14 7l3-3 3 3"></path></svg>
          <span id="rev-label">新しい順</span>
        </button>
      </div>
      <div class="fchips" id="chips" role="group" aria-label="絞り込みの条件" set:html={axisButtonsHtml(EMPTY(), () => [])} />
      {/* 押した軸の選択肢を、条件の段のすぐ下に開く（2026-10-20。開いた軸の fieldset だけを出す。site/scripts/top.ts） */}
      <div class="fpanel" id="fpanel" role="region" aria-labelledby="fpanel-h" hidden>
        {/* 選んだらすぐ絞り込む（2026-10-21）。欄には「クリア」と閉じるだけ */}
        <div class="fpanel-head">
          <h3 id="fpanel-h">条件</h3>
          <button type="button" class="linkish" id="fpanel-clear">クリア</button>
          <button type="button" class="icon-btn" id="fpanel-close" aria-label="閉じる">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <fieldset data-axis="date">
          <legend class="sr">配信日</legend>
          {/* 見出しなしの1列。年は1つの選択にまとめる（2026-10-21） */}
          <div class="opts">
            <label class="chk"><input type="radio" name="date" value="30d" />30日以内</label>
            <label class="chk"><input type="radio" name="date" value="1y" />1年以内</label>
            <label class="sr" for="opt-date-year">配信した年</label>
            <select id="opt-date-year" class="pick">
              <option value="">年を選ぶ</option>
              {streamYears.map((y) => <option value={String(y)}>{y}年</option>)}
            </select>
          </div>
          <p class="hint">枠を配信した日（日本時間）で絞り込みます。作品の放送年は「放送年」で選べます。</p>
        </fieldset>
        <fieldset data-axis="aff">
          <legend class="sr">所属</legend>
          {/* 所属は事務所ごとの選択を横に並べる（2026-10-21 ユーザー決定）。事務所の名前を上に小さく、選択は既定の「すべて」・区分の1つ・「除く」。区分が1つの事務所は「すべて」と「除く」 */}
          <div class="affsel">
            {affs.map((a) => (
              <div class="affcol">
                <label class="afflabel" for={`opt-aff-${a.aff}`}>{a.label}</label>
                <select id={`opt-aff-${a.aff}`} class="pick" data-aff={a.aff} data-branches={a.branches.join(" ")}>
                  <option value="all" selected>すべて</option>
                  {a.branches.length > 1 && a.branches.map((b) => <option value={b}>{BRANCH_LABEL[b]}</option>)}
                  <option value="ex">除く</option>
                </select>
              </div>
            ))}
          </div>
        </fieldset>
        <fieldset data-axis="kind">
          <legend class="sr">作品の種類</legend>
          <div class="opts">
            <label class="chk"><input type="checkbox" name="kind" value="anime" />アニメ</label>
            <label class="chk"><input type="checkbox" name="kind" value="tokusatsu" />特撮</label>
            <label class="chk"><input type="checkbox" name="kind" value="live_action" />実写</label>
          </div>
        </fieldset>
        <fieldset data-axis="movie">
          <legend class="sr">映画かどうか</legend>
          <div class="seg" role="radiogroup" aria-label="映画かどうか">
            <label><input type="radio" name="movie" value="all" checked />すべて</label>
            <label><input type="radio" name="movie" value="movie" />映画</label>
            <label><input type="radio" name="movie" value="other" />映画以外</label>
          </div>
          <p class="hint">映画かどうかが分からない作品は、「映画」「映画以外」のどちらを選んでも出ません。</p>
        </fieldset>
        <fieldset data-axis="country">
          <legend class="sr">制作国</legend>
          <div class="seg" role="radiogroup" aria-label="制作国">
            <label><input type="radio" name="country" value="all" checked />すべて</label>
            <label><input type="radio" name="country" value="jp" />日本</label>
            <label><input type="radio" name="country" value="foreign" />海外<span style="font-size: 11px; font-weight: 500;">（合作を含む）</span></label>
          </div>
          <p class="hint">日本と海外の合作は、どちらを選んでも出ます。制作国が分からない作品は、どちらを選んでも出ません。</p>
        </fieldset>
        <fieldset data-axis="year">
          <legend class="sr">作品の放送年・放送期</legend>
          <div class="yearrow">
            <label class="sr" for="opt-year">放送年</label>
            <select id="opt-year" class="pick">
              <option value="">指定なし</option>
              {years.map((y) => <option value={String(y)}>{y}年</option>)}
            </select>
            <div class="seasons" role="group" aria-label="放送期" id="opt-season">
              {SEASONS.map((s) => <button type="button" data-season={s} aria-pressed="false" disabled>{SEASON_LABEL[s]}</button>)}
            </div>
          </div>
          <p class="hint">作品が放送・公開された年です。放送期（冬・春・夏・秋）は、年を選ぶと選べます。アニメの作品（劇場版・OVA を含む）にだけ付いています。</p>
        </fieldset>
      </div>
    </div>
    <p class="sortnote" id="sort-note" hidden></p>
    <div class="fstatus" id="fstatus" hidden>
      <p class="status" id="status" aria-live="polite"></p>
      <button type="button" class="linkish" id="clear-all" data-remove="all" hidden>条件をすべて外す</button>
    </div>
    <div class="grid" id="done-grid" set:html={recent.map((e, j) => cardHtml(encodeRow(e), recentDict, { lazy: j >= 4 })).join("")} />
    <div id="done-empty"></div>
    <div class="more" id="more">
      {completed.length > recent.length && <button type="button" class="btn" id="more-btn">さらに表示</button>}
      {lastShown && <p>{formatDate(lastShown.startedAt)} までの枠を表示しています</p>}
    </div>
  </section>
</main>

<div class="toast" id="toast" role="status" hidden></div>
<script type="application/json" id="top-config" set:html={JSON.stringify(topConfig)} />
<script>
  import "../scripts/top.ts";
  import "../scripts/rail.ts";
</script>
</Base>
