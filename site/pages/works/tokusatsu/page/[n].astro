---
import WorksList from "../../../../components/WorksList.astro";
import { pageCount, worksOfTab } from "../../../../lib/data.ts";

export function getStaticPaths() {
  const n = pageCount(worksOfTab("tokusatsu").length);
  return Array.from({ length: Math.max(0, n - 1) }, (_, i) => ({ params: { n: String(i + 2) } }));
}
---
<WorksList tab="tokusatsu" page={Number(Astro.params.n)} />
